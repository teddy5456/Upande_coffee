in=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/><line x1=\"14\" y1=\"14\" x2=\"21\" y2=\"21\"/><line x1=\"21\" y1=\"14\" x2=\"14\" y2=\"21\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Coffee QR Sequence</span><span class=\"cfn-sub\">Bucket &amp; picker QR numbering</span></span>\n    </a>\n    <a class=\"cfn-tile\" data-roles=\"Coffee Harvest Manager,System Manager\" href=\"/app/farm\">\n      <span class=\"cfn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 21V10l9-7 9 7v11\"/><line x1=\"3\" y1=\"14\" x2=\"21\" y2=\"14\"/><line x1=\"9\" y1=\"14\" x2=\"9\" y2=\"21\"/><line x1=\"15\" y1=\"14\" x2=\"15\" y2=\"21\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Farms</span><span class=\"cfn-sub\">Farm register</span></span>\n    </a>\n    <a class=\"cfn-tile\" data-roles=\"Coffee Harvest Manager,System Manager\" href=\"/app/warehouse\">\n      <span class=\"cfn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 21V10l9-7 9 7v11\"/><line x1=\"3\" y1=\"14\" x2=\"21\" y2=\"14\"/><line x1=\"9\" y1=\"14\" x2=\"9\" y2=\"21\"/><line x1=\"15\" y1=\"14\" x2=\"15\" y2=\"21\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Warehouses</span><span class=\"cfn-sub\">Blocks, stores &amp; mills</span></span>\n    </a>\n  </div>\n</div>\n",
  "script": "(function() {\n  // Poppins - document-level so it reaches this block's shadow root.\n  try {\n    if (!document.querySelector('link[data-rpn-poppins]')) {\n      var pf=document.createElement('link'); pf.rel='stylesheet'; pf.setAttribute('data-rpn-poppins','1');\n      pf.href='https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap';\n      document.head.appendChild(pf);\n    }\n  } catch(e){}\n\n  // Role-gate tiles: data-roles=\"\" shows for everyone; otherwise only if the\n  // user holds one of the listed roles. System Manager / Administrator see all.\n  var roles = (window.frappe && frappe.user_roles) || [];\n  var isAdmin = roles.indexOf('System Manager') >= 0\n    || roles.indexOf('Administrator') >= 0\n    || (window.frappe && frappe.user && frappe.user.name === 'Administrator');\n  root_element.querySelectorAll('.cfn-tile').forEach(function(tile) {\n    var req = (tile.getAttribute('data-roles') || '')\n      .split(',').map(function(s){return s.trim();}).filter(Boolean);\n    if (req.length === 0) return;\n    var ok = isAdmin || req.some(function(r){ return roles.indexOf(r) >= 0; });\n    if (!ok) tile.classList.add('cfn-hide');\n  });\n\n  // Hide a section label if every tile under it is hidden.\n  root_element.querySelectorAll('.cfn-sec').forEach(function(t){\n    var grid = t.nextElementSibling;\n    if (!grid || !grid.classList.contains('cfn-grid')) return;\n    var vis = grid.querySelectorAll('.cfn-tile:not(.cfn-hide)').length;\n    if (!vis) { t.classList.add('cfn-hide'); grid.classList.add('cfn-hide'); }\n  });\n})();",
  "style": ".cfn{padding:4px 2px;font-family:'Poppins',var(--font-stack),'Inter',sans-serif;}\n.cfn-title{font-size:15px;font-weight:700;color:var(--heading-color,#1f272e);margin:0 0 14px 2px;}\n.cfn-sec{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#8a8f98;font-weight:600;margin:20px 0 10px 2px;}\n.cfn-sec:first-of-type{margin-top:4px;}\n.cfn-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;}\n.cfn-tile{display:flex;align-items:center;gap:11px;padding:13px 15px;border:1px solid var(--border-color,#e2e4e9);border-radius:10px;background:var(--card-bg,#fff);text-decoration:none;color:inherit;transition:box-shadow .18s ease,transform .18s ease;}\n.cfn-tile:hover{box-shadow:0 2px 6px rgba(0,0,0,.06);transform:translateY(-1px);text-decoration:none;}\n.cfn-tile:hover .cfn-lb,.cfn-tile:hover .cfn-sub{text-decoration:none;}\n.cfn-ic{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex:0 0 auto;color:inherit;}\n.cfn-ic svg{width:18px;height:18px;}\n.cfn-tx{min-width:0;display:flex;flex-direction:column;}\n.cfn-lb{display:block;font-size:13.5px;font-weight:600;line-height:1.2;}\n.cfn-sub{display:block;font-size:11px;color:#8a8f98;line-height:1.3;margin-top:2px;}\n.cfn-hide{display:none !important;}",
  "private": 0,
  "roles": []
 }
