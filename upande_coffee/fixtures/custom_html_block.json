 {
  "doctype": "Custom HTML Block",
  "name": "Coffee Navigation",
  "html": "<div class=\"cfn\">\n  <div class=\"cfn-title\">Coffee</div>\n\n  <div class=\"cfn-sec\">Dashboards</div>\n  <div class=\"cfn-grid\">\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/coffee-dashboard\">\n      <span class=\"cfn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"4\" y1=\"20\" x2=\"4\" y2=\"10\"/><line x1=\"10\" y1=\"20\" x2=\"10\" y2=\"4\"/><line x1=\"16\" y1=\"20\" x2=\"16\" y2=\"13\"/><line x1=\"22\" y1=\"20\" x2=\"22\" y2=\"8\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Coffee Dashboard</span><span class=\"cfn-sub\">Harvest, drying, stock &amp; pay</span></span>\n    </a>\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/coffee-production\">\n      <span class=\"cfn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"3 17 9 11 13 15 21 7\"/><polyline points=\"21 12 21 7 16 7\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Coffee Production</span><span class=\"cfn-sub\">Flowering, forecast &amp; pickers</span></span>\n    </a>\n  </div>\n\n  <div class=\"cfn-sec\">Harvest</div>\n  <div class=\"cfn-grid\">\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/app/harvest-log\">\n      <span class=\"cfn-ic\" style=\"background:rgba(22,163,74,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 11h14l-1.5 9h-11z\"/><path d=\"M9 11 12 3l3 8\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Harvest Log</span><span class=\"cfn-sub\">Buckets picked per harvester</span></span>\n    </a>\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/app/harvester\">