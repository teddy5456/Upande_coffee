8\" height=\"18\" rx=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Coffee Seasons</span><span class=\"cfn-sub\">Season dates, targets &amp; rates</span></span>\n    </a>\n  </div>\n\n  <div class=\"cfn-sec\">Planning &amp; Pay</div>\n  <div class=\"cfn-grid\">\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/app/coffee-harvest-plan\">\n      <span class=\"cfn-ic\" style=\"background:rgba(99,102,241,.13);color:#6366f1\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><line x1=\"3\" y1=\"9\" x2=\"21\" y2=\"9\"/><line x1=\"9\" y1=\"9\" x2=\"9\" y2=\"20\"/><line x1=\"15\" y1=\"9\" x2=\"15\" y2=\"20\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Coffee Harvest Plan</span><span class=\"cfn-sub\">Weekly blocks, debes &amp; cash</span></span>\n    </a>\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/app/coffee-payment\">\n      <span class=\"cfn-ic\" style=\"background:rgba(99,102,241,.13);color:#6366f1\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"2.5\"/><line x1=\"6\" y1=\"12\" x2=\"6.01\" y2=\"12\"/><line x1=\"18\" y1=\"12\" x2=\"18.01\" y2=\"12\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Coffee Payments</span><span class=\"cfn-sub\">Picker pay per day</span></span>\n    </a>\n    <a class=\"cfn-tile\" data-roles=\"Coffee Harvest Manager,System Manager\" href=\"/app/coffee-payout-run\">\n      <span class=\"cfn-ic\" style=\"background:rgba(99,102,241,.13);color:#6366f1\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" st