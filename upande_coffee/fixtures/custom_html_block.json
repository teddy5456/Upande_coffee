fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.1V12a10 10 0 1 1-5.9-9.1\"/><polyline points=\"22 4 12 14 9 11\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Quality Inspections</span><span class=\"cfn-sub\">Moisture, intake &amp; cupping</span></span>\n    </a>\n  </div>\n\n  <div class=\"cfn-sec\">Intake &amp; Milling</div>\n  <div class=\"cfn-grid\">\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/app/sales-order?custom_sales_order_type=Coffee\">\n      <span class=\"cfn-ic\" style=\"background:rgba(13,148,136,.13);color:#0d9488\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"9\" y1=\"14\" x2=\"15\" y2=\"14\"/><line x1=\"9\" y1=\"18\" x2=\"13\" y2=\"18\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Bookings</span><span class=\"cfn-sub\">Coffee sales orders</span></span>\n    </a>\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/app/coffee-intake\">\n      <span class=\"cfn-ic\" style=\"background:rgba(13,148,136,.13);color:#0d9488\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Coffee Intake</span><span class=\"cfn-sub\">Parchment arriving at the mill</span></span>\n    </a>\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/app/coffee-intake/new\">\n      <span class=\"cfn-ic\" style=\"background:rgba(13,148,136,.13);color:#0d9488\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"/><line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Record an Intake</span><span class=\"cfn-sub\">New coffee intake</span></span>\n    </a>\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/app/outturn-statement\">\n      <span class=\"cfn-ic\" style=\"background:rgba(13,148,136,.13);color:#0d9488\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v4M12 18v4M2 12h4M18 12h4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Outturn Statements</span><span class=\"cfn-sub\">Milled grades &amp; loss</span></span>\n    </a>\n  </div>\n\n  <div class=\"cfn-sec\">Dispatch &amp; Billing</div>\n  <div class=\"cfn-grid\">\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/app/delivery-note\">\n      <span class=\"cfn-ic\" style=\"background:rgba(225,29,72,.13);color:#e11d48\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"7\" width=\"14\" height=\"10\"/><path d=\"M15 10h4l3 3v4h-7z\"/><circle cx=\"6\" cy=\"19\" r=\"2\"/><circle cx=\"18\" cy=\"19\" r=\"2\"/></svg></span>\n      <span class=\"cfn-tx\"><span class=\"cfn-lb\">Delivery Notes</span><span class=\"cfn-sub\">Dispatch &amp; milling charges</span></span>\n    </a>\n    <a class=\"cfn-tile\" data-roles=\"\" href=\"/app/sales-invoice\">\n      <span class=\"cfn-ic\" style=\"background:rgba(225,29,72,.13);color:#e11d48\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 2v20l3-2 3 2 3-2 3 2 3-2 1 .7V2l-1 .7-3-2-3 2-3-2-3 2-3-2z\"/><li